# Defaults for a fresh clone. Next.js loads this file automatically.
#
# The Debrief analyst runs in mock mode: the route answers from the same tools
# the live model calls, computed off the seeded race, with no network and no
# key. Answers are deterministic, so a clone behaves the way the README says.
#
# To run it against a real model instead, set OPENROUTER_API_KEY in .env.local
# and set LAYLINE_ANALYST_MOCK=0 there. The mock flag wins when both are set.
LAYLINE_ANALYST_MOCK=1

# Optional, live mode only. Unset falls back to the route default.
# OPENROUTER_MODEL=
